k8sServiceHost: {{ internal_network_ki_cp_dns_name }}
k8sServicePort: {{ ki_cp_k8s_cp_lb_port }}
image:
  repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/cilium
  useDigest: false
l2announcements:
  enabled: true
bpf:
  masquerade: true
  preallocateMaps: true
ingressController:
  enabled: true
  default: true
  loadbalancerMode: shared
  ingressLBAnnotationPrefixes:
    - lbipam.cilium.io
    - nodeipam.cilium.io
    - service.beta.kubernetes.io
    - service.kubernetes.io
    - cloud.google.com
    - k8s-installer.ten1010.io
{%- if k8s_default_ingress_class_load_balancer %}
  service:
    labels:
      k8s-installer.ten1010.io/load-balancer: {{ k8s_default_ingress_class_load_balancer }}
    annotations:
      lbipam.cilium.io/sharing-key: {{ k8s_default_ingress_class_load_balancer }}
      lbipam.cilium.io/sharing-cross-namespace: "*"
{%- else %}
  hostNetwork:
    enabled: true
    sharedListenerPort: {{ k8s_default_ingress_class_host_network_port }}
{%- endif %}
hubble:
  # 민감 HTTP 헤더 마스킹 — allow 에 나열한 헤더만 값 노출, 나머지 자동 차단
  redact:
    enabled: true
    http:
      urlQuery: false
      userInfo: true
      headers:
        allow:
          - x-envoy-upstream-service-time
          - x-request-id
          - content-type
          - host
          - authority
          - x-forwarded-for
        deny: []
  # flow export (static) — L7 전체 + L4 DROPPED/ERROR, kube-system/cilium 제외
  export:
    fileMaxSizeMb: 50
    fileMaxBackups: 5
    fileCompress: true
    static:
      enabled: true
      filePath: "/var/run/cilium/hubble/events.log"
      fieldMask:
        - time
        - verdict
        - traffic_direction
        - Type
        - event_type
        - is_reply
        - IP
        - l4
        - l7
        - source.identity
        - source.namespace
        - source.pod_name
        - source.workloads
        - source.labels
        - destination.identity
        - destination.namespace
        - destination.pod_name
        - destination.workloads
        - destination.labels
        - node_name
      allowList:
        - '{"event_type":[{"type":129}]}'
      denyList:
        - '{"source_pod":["kube-system/","cilium/"]}'
        - '{"destination_pod":["kube-system/","cilium/"]}'
  metrics:
    enabled: ~
    serviceMonitor:
      enabled: false
    dynamic:
      enabled: true
      config:
        configMapName: cilium-dynamic-metrics-config
        createConfigMap: true
        content:
          - name: httpV2
            contextOptions:
              - name: exemplars
                values:
                  - "false"
              - name: labelsContext
                values:
                  - source_namespace
                  - source_workload
                  - destination_namespace
                  - destination_workload
                  - destination_pod
                  - traffic_direction
            includeFilters: []
            excludeFilters:
              - http_path:
                - "^/favicon\\.ico$"
    dashboards:
      enabled: true
  relay:
    enabled: false
    image:
      repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/hubble-relay
      useDigest: false
    prometheus:
      enabled: true
  ui:
    enabled: false
    backend:
      image:
        repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/hubble-ui-backend
        useDigest: false
    frontend:
      image:
        repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/hubble-ui
        useDigest: false
ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
    - {{ k8s_pod_subnet }}
kubeProxyReplacement: true
prometheus:
  enabled: true
dashboards:
  enabled: true
envoy:
  image:
    repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/cilium-envoy
    useDigest: false
  idleTimeoutDurationSeconds: {{ k8s_cilium_envoy_idle_timeout_seconds | int }}
  streamIdleTimeoutDurationSeconds: {{ k8s_cilium_envoy_idle_timeout_seconds | int }}
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
        - NET_ADMIN
        - SYS_ADMIN
        - NET_BIND_SERVICE
extraConfig:
  proxy-stream-idle-timeout-seconds: "{{ k8s_cilium_envoy_idle_timeout_seconds }}"
operator:
  image:
    repository: {{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/cilium/operator
    useDigest: false
  dashboards:
    enabled: true
gatewayAPI:
  enabled: true
